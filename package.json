{
  "name": "@webship.co/workspace-google-drive",
  "version": "1.0.14",
  "description": "Google Drive for Webship Workspace: a Sync to Drive button on the videos, audio, docs, specs and test workspaces, the command line behind it, a Google Drive MCP server for Claude Code, and the plugin's own settings file. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt.",
  "main": "dist/src/index.js",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-google-drive.git"
  },
  "bin": {
    "workspace-google-drive": "dist/src/lib/cli.js"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "google-drive-sync",
    "label": "Google Drive",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "suggests": [
      [
        "video",
        "audio",
        "docs",
        "specs",
        "test"
      ]
    ],
    "settingsFile": "plugin.google-drive-sync.settings.yml",
    "settingsTemplate": "config/plugin.google-drive-sync.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "google_drive",
    "workspaces": "videos,audio,docs,specs,test",
    "commands": {
      "workspaces": [
        "videos",
        "audio",
        "docs",
        "specs",
        "test"
      ],
      "files": [
        "commands/cmd-tools-google-drive-sync.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-drive-sync.sh"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/google-drive-pusher.md"
      ],
      "skills": [
        "ai/skills/google-drive-push"
      ],
      "commands": [
        "ai/commands/google-drive-preview.md"
      ],
      "prompts": [
        "ai/prompts/google-drive-push-folder.md"
      ]
    },
    "features": [
      "features/google-drive.feature"
    ]
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
